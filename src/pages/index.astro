---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import logo from '../assets/brand/sos-logo.png';
import { site, whatsappLink } from '../data/site';
import { services, checking, emergencyResponse } from '../data/company';
import { clients } from '../data/clients';

const steps = [
  { icon: 'check', title: 'Selection', text: 'Guards aged 20–50, medically fit, literate and trained in weapon handling. Supervisors must be matriculates with the ability to command.' },
  { icon: 'id', title: 'Verification', text: 'CNIC verification through Verisys – NADRA, local police verification and home-town verification.' },
  { icon: 'book', title: 'Training', text: 'Orientation, weapon handling, fire fighting and emergency procedures, and body guard training — with firing at the APSAA Training School.' },
  { icon: 'shield', title: 'Deployment', text: 'Guards are deployed with supervisor checks, a round-the-clock control room and a reserve for jump deployments.' },
] as const;

const featuredClients = clients.filter((_, i) => i % 9 === 1).slice(0, 10);
const milestones = [
  { year: '1995', text: 'Incorporated in Karachi' },
  { year: '1999', text: 'Ministry of Interior & Govt. of Sindh no-objection letters' },
  { year: '2002', text: 'Certificate of Appreciation, Home Department, Govt. of Sindh' },
  { year: '2016', text: 'APSAA membership certificate' },
  { year: '2018', text: 'Sindh Revenue Board registration certificate' },
];
---
<Base
  title="Home"
  description="Sofia Orient Security Services (Pvt.) Ltd., Karachi: trained and verified security guards, escort services, security and communication equipment, and video digital surveillance. Call or WhatsApp for a quote."
>
  <!-- Hero -->
  <section class="hero">
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Private security company · Karachi</p>
        <h1>Trained, verified security for your premises.</h1>
        <p class="hero-lead">
          Sofia Orient Security Services provides security guards, escort services, security and communication
          equipment, and video digital surveillance — backed by careful selection, verification, training and a
          control room manned round the clock.
        </p>
        <div class="btn-row">
          <a class="btn btn--gold" href={site.phone.href}><Icon name="phone" /> Call Now</a>
          <a class="btn btn--whatsapp" href={whatsappLink('Hello, I would like to discuss security services.')} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
          <a class="btn btn--ghost" href="/contact/#quote"><Icon name="doc" /> Request a Quote</a>
        </div>
        <p class="hero-phone">Call <a href={site.phone.href}>{site.phone.display}</a> · WhatsApp <a href={site.whatsapp.href} target="_blank" rel="noopener">{site.whatsapp.display}</a></p>
      </div>

      <aside class="hero-panel" aria-label="At a glance">
        <div class="panel-head">
          <Image src={logo} alt={`${site.legalName} logo`} width={160} height={160} class="panel-logo" loading="eager" />
          <div>
            <p class="panel-name">{site.legalName}</p>
            <p class="panel-sub">Incorporated in Karachi, 1995</p>
          </div>
        </div>
        <ul class="panel-list">
          <li><Icon name="control" /><span><strong>Control room</strong> manned round the clock</span></li>
          <li><Icon name="clock" /><span><strong>Supervisor checks</strong> daily from 07:00 and 19:00</span></li>
          <li><Icon name="id" /><span><strong>Guards verified</strong> through NADRA, police and home town</span></li>
          <li><Icon name="radio" /><span><strong>Radio contact</strong> between guards on site</span></li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">What we provide</p>
        <h2>Security services</h2>
        <p>Five services, delivered by a team organised around supervision, communication and clear reporting lines.</p>
      </div>
      <div class="grid grid-3 services-grid">
        {services.map((s) => (
          <a class="card card--hover service-card reveal" href={`/services/#${s.slug}`}>
            <span class="icon-badge"><Icon name={s.icon} /></span>
            <h3>{s.title}</h3>
            <p>{s.summary}</p>
            <span class="text-link">Learn more <Icon name="arrow" /></span>
          </a>
        ))}
        <div class="card service-card service-card--cta reveal">
          <h3>Not sure what you need?</h3>
          <p>Tell us about your premises and we will discuss the right arrangement with you.</p>
          <div class="btn-row">
            <a class="btn btn--navy" href="/contact/#quote">Request a Quote</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Selection to deployment -->
  <section class="section section--mist">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Our guards</p>
        <h2>From selection to deployment</h2>
        <p>Every guard goes through the same four stages before taking up duty.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step reveal">
            <span class="step-num">0{i + 1}</span>
            <span class="icon-badge icon-badge--soft"><Icon name={s.icon} /></span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="reveal"><a class="text-link" href="/training-operations/">See selection, verification and training in detail <Icon name="arrow" /></a></p>
    </div>
  </section>

  <!-- Operations -->
  <section class="section section--dark ops">
    <div class="container split">
      <div class="reveal">
        <p class="eyebrow">Operations &amp; monitoring</p>
        <h2>Supervision you can see on the ground</h2>
        <p>Our control room is manned round the clock, receives every message and takes appropriate action. Checking staff, Manager Operations and the General Manager each check sites on a fixed schedule, and client feedback forms part of our monitoring.</p>
        <ul class="schedule">
          {checking.map((c) => (
            <li><span class="schedule-when">{c.when}</span><span class="schedule-who">{c.who}</span></li>
          ))}
        </ul>
        <a class="text-link text-link--light" href="/training-operations/#operations">How our operations work <Icon name="arrow" /></a>
      </div>
      <div class="reveal">
        <div class="emergency">
          <p class="emergency-title"><Icon name="alert" /> Emergency response</p>
          <ol>
            {emergencyResponse.map((e) => (
              <li><span class="em-icon"><Icon name={e.icon} /></span><span><strong>{e.title}.</strong> {e.text}</span></li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- Clients -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Clients</p>
        <h2>Organisations we have served</h2>
        <p>Our company profile lists 100 major clients across textiles, manufacturing, insurance, education, healthcare, retail, fuel stations and residential complexes.</p>
      </div>
      <ul class="client-chips reveal">
        {featuredClients.map((c) => <li>{c}</li>)}
      </ul>
      <div class="client-foot reveal">
        <a class="btn btn--navy" href="/clients/">View all 100 clients</a>
        <p class="small-note">Names as listed in our company profile. This is a historical list and does not indicate current contracts.</p>
      </div>
    </div>
  </section>

  <!-- Credentials -->
  <section class="section section--mist">
    <div class="container split">
      <div class="reveal">
        <p class="eyebrow">Credentials</p>
        <h2>Registered and documented since 1995</h2>
        <p class="lead">Our certificates and official letters are published as they appear in our company profile, with their dates. They are historical records; for the current status of any licence or registration, please contact us.</p>
        <a class="btn btn--navy" href="/credentials/"><Icon name="doc" /> View certificates</a>
      </div>
      <ol class="milestones reveal">
        {milestones.map((m) => (
          <li><span class="ms-year">{m.year}</span><span>{m.text}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { position: relative; overflow: hidden; background: var(--navy-900); color: rgb(255 255 255 / 0.78); padding: clamp(56px, 8vw, 104px) 0 clamp(56px, 8vw, 96px); }
  .hero::after {
    content: ''; position: absolute; inset: auto -10% -40% auto; width: 60%; height: 80%; pointer-events: none;
    background: radial-gradient(closest-side, rgb(201 162 39 / 0.12), transparent);
  }
  .hero-inner { position: relative; z-index: 1; display: grid; gap: clamp(36px, 5vw, 64px); align-items: center; }
  @media (min-width: 1000px) { .hero-inner { grid-template-columns: 1.25fr 0.9fr; } }
  .hero h1 { color: var(--white); font-size: clamp(2.1rem, 5vw, 3.5rem); max-width: 15ch; }
  .hero .eyebrow { color: var(--gold-soft); }
  .hero-lead { font-size: clamp(1.03rem, 1.5vw, 1.18rem); max-width: 58ch; margin-bottom: 28px; }
  .hero-phone { margin: 18px 0 0; font-size: 0.92rem; color: rgb(255 255 255 / 0.65); }
  .hero-phone a { color: var(--white); text-decoration: none; font-weight: 600; }
  .hero-phone a:hover { color: var(--gold-soft); text-decoration: underline; }

  .hero-panel { background: rgb(255 255 255 / 0.04); border: 1px solid var(--line-dark); border-radius: var(--radius-l); padding: clamp(22px, 3vw, 32px); backdrop-filter: blur(4px); }
  .panel-head { display: flex; align-items: center; gap: 16px; padding-bottom: 20px; border-bottom: 1px solid var(--line-dark); }
  .panel-head :global(.panel-logo) { width: 72px; height: 72px; border-radius: 50%; flex: none; box-shadow: 0 0 0 4px rgb(255 255 255 / 0.08); }
  .panel-name { margin: 0; color: var(--white); font-family: var(--font-head); font-weight: 600; line-height: 1.3; }
  .panel-sub { margin: 4px 0 0; font-size: 0.88rem; color: var(--gold-soft); }
  .panel-list { list-style: none; margin: 20px 0 0; padding: 0; display: grid; gap: 16px; }
  .panel-list li { display: flex; gap: 14px; align-items: flex-start; font-size: 0.97rem; }
  .panel-list :global(svg) { width: 22px; height: 22px; flex: none; color: var(--gold); margin-top: 2px; }
  .panel-list strong { color: var(--white); font-weight: 600; }

  .service-card { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  .service-card p { flex: 1; }
  .service-card .text-link { margin-top: 4px; }
  .service-card--cta { background: var(--navy-900); border-color: var(--navy-900); box-shadow: none; }
  .service-card--cta h3 { color: var(--white); }
  .service-card--cta p { color: rgb(255 255 255 / 0.74); }
  .service-card--cta .btn--navy { background: var(--gold); color: var(--navy-950); }
  .service-card--cta .btn--navy:hover { background: #d8b23a; }

  .steps { list-style: none; margin: 0 0 32px; padding: 0; display: grid; gap: clamp(16px, 2vw, 24px); grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); counter-reset: s; }
  .step { position: relative; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; box-shadow: var(--shadow); }
  .step-num { position: absolute; top: 20px; right: 22px; font-family: var(--font-head); font-weight: 700; font-size: 1.6rem; color: var(--numeral); }
  .step p { color: var(--slate); margin: 0; font-size: 0.96rem; }

  .ops { position: relative; overflow: hidden; }
  .ops p { color: rgb(255 255 255 / 0.76); }
  .schedule { list-style: none; margin: 28px 0 28px; padding: 0; display: grid; gap: 10px; }
  .schedule li { display: flex; flex-direction: column; gap: 2px; padding: 14px 18px; border-radius: var(--radius-s); background: rgb(255 255 255 / 0.05); border-left: 3px solid var(--gold); }
  .schedule-when { color: var(--white); font-weight: 600; font-family: var(--font-head); font-size: 0.98rem; }
  .schedule-who { font-size: 0.9rem; color: rgb(255 255 255 / 0.66); }
  .text-link--light { color: var(--gold-soft); }
  .text-link--light:hover { color: var(--white); }

  .emergency { background: var(--white); color: var(--charcoal); border-radius: var(--radius-l); padding: clamp(22px, 3vw, 32px); box-shadow: var(--shadow-lift); }
  .emergency .emergency-title { display: flex; align-items: center; gap: 10px; font-family: var(--font-head); font-weight: 600; font-size: 1.15rem; color: var(--navy-900); margin: 0 0 18px; }
  .emergency-title :global(svg) { width: 22px; height: 22px; color: var(--danger); }
  .emergency ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .emergency li { display: flex; gap: 14px; align-items: flex-start; font-size: 0.96rem; color: var(--slate); }
  .emergency strong { color: var(--navy-900); }
  .em-icon { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 9px; background: var(--mist); color: var(--navy-900); flex: none; }
  .em-icon :global(svg) { width: 19px; height: 19px; }

  .client-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .client-chips li { padding: 10px 16px; border: 1px solid var(--line); border-radius: 999px; font-size: 0.93rem; color: var(--navy-900); background: var(--white); }
  .client-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 28px; }
  .small-note { margin: 0; font-size: 0.86rem; color: var(--slate); max-width: 52ch; }

  .milestones { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-left: 2px solid var(--line); }
  .milestones li { position: relative; display: grid; grid-template-columns: 64px 1fr; gap: 16px; padding: 14px 0 14px 24px; }
  .milestones li::before { content: ''; position: absolute; left: -7px; top: 22px; width: 12px; height: 12px; border-radius: 50%; background: var(--white); border: 2px solid var(--gold-ink); }
  .ms-year { font-family: var(--font-head); font-weight: 700; color: var(--navy-900); }
</style>
