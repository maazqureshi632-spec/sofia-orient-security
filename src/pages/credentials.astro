---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { credentials } from '../data/credentials';
import { whatsappLink } from '../data/site';

// Chronological, with undated documents last.
const sorted = [...credentials].sort((a, b) => (a.year ?? 9999) - (b.year ?? 9999));

// Large versions for the viewer, generated at build time. Image metadata is not read directly,
// so the original high-resolution scans are not copied into the build.
const items = await Promise.all(
  sorted.map(async (c) => ({
    ...c,
    full: await Promise.all(
      c.images.map(async (img) => {
        const large = await getImage({ src: img.src, width: 1400, format: 'webp' });
        return { src: large.src, width: Number(large.attributes.width), height: Number(large.attributes.height), alt: img.alt };
      }),
    ),
  })),
);
---
<Base
  title="Certificates & Credentials"
  description="Historical certificates and letters of Sofia Orient Security Services: incorporation (1995), Ministry of Interior and Home Department Sindh letters (1999), appreciation (2002), NTN (2003), APSAA membership (2016) and SRB registration (2018)."
>
  <PageHero
    crumb="Credentials"
    eyebrow="Certificates & credentials"
    title="Company records and certificates"
    lead="Copies of the certificates and official letters reproduced in our company profile, shown in date order with the issuing body and date as printed on each document."
  />

  <section class="section">
    <div class="container">
      <div class="note reveal">
        <Icon name="alert" />
        <p><strong>Historical records.</strong> These documents are shown as issued, on the dates printed on them. Licences, NOCs and memberships are issued for a limited period and must be renewed, so these copies do not by themselves show current validity. For the current status of any registration or licence, please <a href="/contact/">contact us</a>.</p>
      </div>

      <ul class="gallery">
        {items.map((c) => (
          <li class="doc reveal">
            <button
              type="button"
              class="doc-thumb"
              data-open={c.id}
              aria-haspopup="dialog"
              aria-label={`View larger: ${c.title}, ${c.date}`}
            >
              <Image src={c.images[0].src} alt="" width={440} format="webp" loading="lazy" decoding="async" />
              {c.images.length > 1 && <span class="pages">{c.images.length} pages</span>}
              <span class="zoom"><Icon name="search" /></span>
            </button>
            <div class="doc-body">
              <p class="doc-date">{c.date}</p>
              <h2>{c.title}</h2>
              <p class="doc-issuer">{c.issuer}</p>
              <p class="doc-desc">{c.description}</p>
            </div>
          </li>
        ))}
      </ul>

      <p class="foot-note">Personal documents of staff and any other confidential records in the company profile are not published on this website.</p>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container split verify">
      <div class="reveal">
        <p class="eyebrow">Due diligence</p>
        <h2>Need copies for your records?</h2>
        <p class="lead">If your procurement or compliance team needs documents or confirmation of current registration status, contact us and tell us what you require.</p>
      </div>
      <div class="btn-row reveal">
        <a class="btn btn--navy" href="/contact/">Contact us</a>
        <a class="btn btn--outline" href={whatsappLink('Hello, I would like to request company documents / registration status.')} target="_blank" rel="noopener"><Icon name="whatsapp" /> Ask on WhatsApp</a>
      </div>
    </div>
  </section>

  <CtaBand />

  <dialog class="viewer" aria-labelledby="viewer-title" data-viewer>
    <div class="viewer-bar">
      <div>
        <p id="viewer-title" class="viewer-title"></p>
        <p class="viewer-meta"></p>
        <a class="viewer-full" data-full href="#" target="_blank" rel="noopener">Open full size<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
      <button type="button" class="viewer-close" data-close aria-label="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
    <div class="viewer-stage" data-stage></div>
    <div class="viewer-nav">
      <button type="button" class="btn btn--ghost" data-prev>Previous</button>
      <span class="viewer-count" aria-live="polite"></span>
      <button type="button" class="btn btn--ghost" data-next>Next</button>
    </div>
  </dialog>

  <script type="application/json" id="credential-data" set:html={JSON.stringify(items.map((c) => ({ id: c.id, title: c.title, date: c.date, issuer: c.issuer, pages: c.full }))).replace(/</g, '\\u003c')} />
</Base>

<style>
  .gallery { list-style: none; margin: 32px 0 0; padding: 0; display: grid; gap: 24px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .doc { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--radius); background: var(--white); box-shadow: var(--shadow); overflow: hidden; }
  .doc-thumb {
    position: relative; display: block; width: 100%; aspect-ratio: 4 / 5; padding: 18px; border: 0; border-bottom: 1px solid var(--line);
    background: var(--mist); cursor: zoom-in; overflow: hidden;
  }
  .doc-thumb :global(img) { width: 100%; height: 100%; object-fit: contain; object-position: center; box-shadow: 0 6px 18px -8px rgb(11 22 38 / 0.35); background: var(--white); transition: transform 0.4s var(--ease); }
  .doc-thumb:hover :global(img) { transform: scale(1.02); }
  .doc-thumb:focus-visible { outline: 3px solid var(--gold); outline-offset: -3px; }
  .pages { position: absolute; left: 12px; top: 12px; padding: 3px 10px; border-radius: 999px; background: var(--navy-900); color: var(--white); font-size: 0.78rem; font-weight: 600; }
  .zoom { position: absolute; right: 12px; bottom: 12px; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: var(--navy-900); color: var(--gold); }
  .zoom :global(svg) { width: 18px; height: 18px; }
  .doc-body { padding: 20px 22px 24px; display: flex; flex-direction: column; flex: 1; }
  .doc-date { margin: 0 0 6px; font-family: var(--font-head); font-weight: 600; font-size: 0.85rem; color: var(--gold-ink); }
  .doc-body h2 { font-size: 1.15rem; margin: 0 0 4px; }
  .doc-issuer { margin: 0 0 12px; font-size: 0.9rem; font-weight: 500; color: var(--navy-700); }
  .doc-desc { margin: 0; font-size: 0.93rem; color: var(--slate); }
  .foot-note { margin: 28px 0 0; font-size: 0.88rem; color: var(--slate); }
  .verify { align-items: center; }

  .viewer {
    width: min(100vw - 24px, 1100px); max-width: none; height: min(100dvh - 24px, 1000px); max-height: none; padding: 0;
    border: 0; border-radius: var(--radius); background: var(--navy-950); color: var(--white); overflow: hidden;
  }
  .viewer[open] { display: grid; grid-template-rows: auto 1fr auto; }
  .viewer::backdrop { background: rgb(8 17 31 / 0.82); }
  .viewer-bar { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; padding: 16px 18px; border-bottom: 1px solid var(--line-dark); }
  .viewer-title { margin: 0; font-family: var(--font-head); font-weight: 600; }
  .viewer-meta { margin: 2px 0 0; font-size: 0.86rem; color: rgb(255 255 255 / 0.65); }
  .viewer-full { display: inline-block; margin-top: 6px; font-size: 0.86rem; font-weight: 600; color: var(--gold-soft); }
  .viewer-full:hover { color: var(--white); }
  :global(html:has(dialog[open])) { overflow: hidden; }
  .viewer-close { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line-dark); background: transparent; color: var(--white); cursor: pointer; }
  .viewer-close svg { width: 22px; height: 22px; }
  .viewer-close:hover { border-color: var(--gold); }
  .viewer-stage { min-height: 0; overflow: auto; padding: 16px; display: grid; place-items: start center; }
  .viewer-stage img { max-width: 100%; height: auto; background: var(--white); }
  .viewer-nav { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 18px; border-top: 1px solid var(--line-dark); }
  .viewer-nav .btn { min-height: 44px; }
  .viewer-count { font-size: 0.88rem; color: rgb(255 255 255 / 0.7); }
</style>

<script>
  type Page = { src: string; width: number; height: number; alt: string };
  type Doc = { id: string; title: string; date: string; issuer: string; pages: Page[] };

  const docs: Doc[] = JSON.parse(document.getElementById('credential-data')?.textContent ?? '[]');
  // Flatten so Previous/Next steps through every page of every document.
  const pages = docs.flatMap((d) => d.pages.map((p, i) => ({ doc: d, page: p, index: i })));

  const dialog = document.querySelector<HTMLDialogElement>('[data-viewer]');
  const stage = dialog?.querySelector<HTMLElement>('[data-stage]');
  const titleEl = dialog?.querySelector<HTMLElement>('.viewer-title');
  const metaEl = dialog?.querySelector<HTMLElement>('.viewer-meta');
  const countEl = dialog?.querySelector<HTMLElement>('.viewer-count');
  let current = 0;
  let opener: HTMLElement | null = null;

  function render() {
    const item = pages[current];
    if (!item || !stage || !titleEl || !metaEl || !countEl) return;
    const { doc, page, index } = item;
    titleEl.textContent = doc.title;
    metaEl.textContent = `${doc.issuer} · ${doc.date}${doc.pages.length > 1 ? ` · page ${index + 1} of ${doc.pages.length}` : ''}`;
    countEl.textContent = `${current + 1} / ${pages.length}`;
    const img = new Image(page.width, page.height);
    img.src = page.src;
    img.alt = page.alt;
    img.decoding = 'async';
    stage.replaceChildren(img);
    const full = dialog?.querySelector<HTMLAnchorElement>('[data-full]');
    if (full) full.href = page.src;
    stage.scrollTop = 0;
  }

  function open(id: string, trigger: HTMLElement) {
    if (!dialog) return;
    const i = pages.findIndex((p) => p.doc.id === id);
    if (i < 0) return;
    current = i;
    opener = trigger;
    render();
    dialog.showModal();
    dialog.querySelector<HTMLElement>('[data-close]')?.focus();
  }

  function step(delta: number) {
    current = (current + delta + pages.length) % pages.length;
    render();
  }

  document.querySelectorAll<HTMLElement>('[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => open(btn.dataset.open ?? '', btn));
  });
  dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('[data-prev]')?.addEventListener('click', () => step(-1));
  dialog?.querySelector('[data-next]')?.addEventListener('click', () => step(1));
  dialog?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
  });
  // Close when the backdrop (outside the panel) is clicked.
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => {
    stage?.replaceChildren();
    opener?.focus();
  });
</script>
