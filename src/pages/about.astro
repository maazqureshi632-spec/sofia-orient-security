---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { history, orgChart, benefits, accommodation } from '../data/company';
import { site } from '../data/site';
---
<Base
  title="About Us"
  description="About Sofia Orient Security Services (Pvt.) Ltd.: incorporated in Karachi in 1995, with its history, organisational structure and approach to selecting, training and supervising guards."
>
  <PageHero
    crumb="About"
    eyebrow="About us"
    title="A Karachi security company since 1995"
    lead={`${site.legalName} was incorporated in Karachi in 1995 and began operations in March 2000. We provide security guards and related services, run on clear procedures for selection, verification, training, supervision and reporting.`}
  />

  <section class="section">
    <div class="container split">
      <div class="reveal">
        <p class="eyebrow">Who we are</p>
        <h2>Built on procedure and supervision</h2>
        <p class="lead">Our guards are selected against defined criteria, verified through NADRA, the police and their home town, and trained before deployment. Once on duty they are supported by supervisors, checking staff and a control room that is manned round the clock.</p>
        <p>Since the company began operating, our checking staff have checked client premises twice a day, or at random, to meet the professional requirements of security and surveillance.</p>
        <div class="btn-row" style="margin-top: 24px">
          <a class="btn btn--navy" href="/training-operations/">Training &amp; operations</a>
          <a class="btn btn--outline" href="/services/">Our services</a>
        </div>
      </div>
      <div class="card values reveal">
        <h3>How we work</h3>
        <ul class="check-list">
          <li>Selection criteria for guards and supervisors</li>
          <li>NADRA, local police and home-town verification</li>
          <li>Training through the APSAA Training School</li>
          <li>Control room manned round the clock</li>
          <li>Physical checks daily from 07:00 and 19:00, weekly by Manager Operations and monthly by the General Manager</li>
          <li>Defined reporting channels and emergency response procedure</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--mist" id="history">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Our history</p>
        <h2>Milestones</h2>
        <p>Dates and references as recorded in our company profile and the documents reproduced in it.</p>
      </div>
      <ol class="timeline">
        {history.map((h) => (
          <li class="reveal">
            <span class="tl-date">{h.date}</span>
            <div class="tl-body">
              <h3>{h.title}</h3>
              <p>{h.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="reveal"><a class="text-link" href="/credentials/">See the certificates and letters <Icon name="arrow" /></a></p>
    </div>
  </section>

  <section class="section" id="structure">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <p class="eyebrow">Organisation</p>
        <h2>Organisational structure</h2>
        <p>Operations and administration report through the General Manager to the CEO.</p>
      </div>
      <div class="org reveal" role="img" aria-label="Organisation chart: CEO, then General Manager. Under the General Manager, Manager Operation leads CSO Operation, Security Officers and Guards; Manager Admin leads CSO Admin, with Accountant, Operators, Quarter Master and Maintenance/Others.">
        {orgChart.top.map((r) => <div class="org-node org-node--top">{r}</div>)}
        <div class="org-branches">
          <div class="org-col">
            {orgChart.operations.map((r, i) => <div class={`org-node ${i === 0 ? 'org-node--lead' : ''}`}>{r}</div>)}
          </div>
          <div class="org-col">
            <div class="org-node org-node--lead">{orgChart.admin.manager}</div>
            <div class="org-node">{orgChart.admin.cso}</div>
            <div class="org-team">
              {orgChart.admin.teams.map((t) => <div class="org-node org-node--small">{t}</div>)}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--mist" id="people">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Our people</p>
        <h2>Looking after our guards</h2>
        <p>Benefits and facilities for guards, as set out in our company profile.</p>
      </div>
      <div class="grid grid-2">
      <div class="card reveal">
        <span class="icon-badge"><Icon name="team" /></span>
        <h3>Guard benefits</h3>
        <ul class="check-list">{benefits.map((b) => <li>{b}</li>)}</ul>
      </div>
      <div class="card reveal">
        <span class="icon-badge"><Icon name="home" /></span>
        <h3>Accommodation &amp; transport</h3>
        <p>{accommodation}</p>
      </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .values h3 { margin-bottom: 18px; }
  .timeline { list-style: none; margin: 0 0 32px; padding: 0; display: grid; gap: 0; }
  .timeline li { display: grid; gap: 6px 32px; padding: 22px 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 720px) { .timeline li { grid-template-columns: 200px 1fr; } }
  .tl-date { font-family: var(--font-head); font-weight: 600; color: var(--gold-ink); font-size: 0.95rem; }
  .tl-body h3 { margin-bottom: 0.3em; }
  .tl-body p { margin: 0; color: var(--slate); }

  .org { display: grid; justify-items: center; gap: 14px; }
  .org-node {
    position: relative; min-width: 200px; text-align: center; padding: 12px 18px; border-radius: var(--radius-s);
    background: var(--white); border: 1px solid var(--line); font-family: var(--font-head); font-weight: 600; font-size: 0.93rem; color: var(--navy-900); box-shadow: var(--shadow);
  }
  .org-node--top { background: var(--navy-900); color: var(--white); border-color: var(--navy-900); }
  .org-node--lead { border-top: 3px solid var(--gold); }
  .org-node--small { display: grid; place-items: center; min-width: 0; font-size: 0.86rem; font-weight: 500; padding: 10px 12px; }
  .org-branches { display: grid; gap: 24px; width: 100%; margin-top: 10px; padding-top: 24px; border-top: 2px solid var(--line); }
  @media (min-width: 760px) { .org-branches { grid-template-columns: 1fr 1fr; } }
  .org-col { display: grid; gap: 12px; justify-items: center; align-content: start; }
  .org-col > .org-node { width: min(100%, 280px); }
  .org-team { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: min(100%, 360px); }
</style>
