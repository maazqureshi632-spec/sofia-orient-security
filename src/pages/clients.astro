---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { clients } from '../data/clients';

// Group the list by first letter, keeping the order printed in the company profile.
const groups = new Map<string, string[]>();
for (const name of clients) {
  const ch = name.trim().charAt(0).toUpperCase();
  const key = /[A-Z]/.test(ch) ? ch : '#';
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(name);
}
const letters = [...groups.keys()];
---
<Base
  title="Clients"
  description={`The ${clients.length} organisations listed as major clients in the company profile of Sofia Orient Security Services, including industry, textiles, education, retail and residential premises in Karachi.`}
>
  <PageHero
    crumb="Clients"
    eyebrow="Clients"
    title="Organisations we have served"
    lead={`The ${clients.length} organisations below appear in the “List of Major Clients” in our company profile. Search by name or browse by letter.`}
  />

  <section class="section">
    <div class="container">
      <div class="note reveal"><Icon name="alert" /><p><strong>Please note:</strong> this is the client list as recorded in our company profile. It is a historical record and does not indicate which organisations are current clients, nor any endorsement by them.</p></div>

      <div class="tools" data-clients-tools>
        <div class="search">
          <label for="client-search" class="sr-only">Search clients</label>
          <Icon name="search" />
          <input id="client-search" type="search" placeholder="Search client names" autocomplete="off" spellcheck="false" aria-describedby="client-count" />
        </div>
        <p id="client-count" class="count" aria-live="polite"><span data-count>{clients.length}</span> of {clients.length} clients</p>
      </div>

      <nav class="az" aria-label="Jump to letter">
        {letters.map((l) => <a href={`#letter-${l === '#' ? 'num' : l}`} data-letter-link={l}>{l}</a>)}
      </nav>

      <div class="groups">
        {[...groups].map(([letter, names]) => (
          <section class="group" id={`letter-${letter === '#' ? 'num' : letter}`} data-group={letter} aria-labelledby={`h-${letter === '#' ? 'num' : letter}`}>
            <h2 id={`h-${letter === '#' ? 'num' : letter}`} class="group-letter">{letter}</h2>
            <ul class="names">
              {names.map((n) => <li data-name={n.toLowerCase()}>{n}</li>)}
            </ul>
          </section>
        ))}
      </div>

      <div class="empty" data-empty hidden>
        <p><strong>No clients match “<span data-query></span>”.</strong></p>
        <p>Try a shorter or different spelling, or <button type="button" class="link-btn" data-clear>clear the search</button>.</p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .note { margin: 0 0 28px; }
  .tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; margin-bottom: 18px; }
  .search { position: relative; flex: 1 1 320px; max-width: 520px; }
  .search :global(svg) { position: absolute; left: 16px; top: 50%; translate: 0 -50%; width: 20px; height: 20px; color: var(--slate); pointer-events: none; }
  .search input {
    width: 100%; min-height: 52px; padding: 12px 16px 12px 46px; border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--white); font: inherit; color: var(--charcoal); box-shadow: var(--shadow);
  }
  .search input:focus { border-color: var(--navy-700); outline: 3px solid var(--gold); outline-offset: 2px; }
  .count { margin: 0; color: var(--slate); font-size: 0.95rem; }

  .az { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 32px; }
  .az a {
    display: grid; place-items: center; min-width: 38px; height: 38px; padding: 0 8px; border-radius: var(--radius-s);
    border: 1px solid var(--line); text-decoration: none; font-family: var(--font-head); font-weight: 600; font-size: 0.9rem; color: var(--navy-900); background: var(--white);
  }
  .az a:hover { border-color: var(--navy-700); background: var(--mist); }
  .az a[aria-disabled='true'] { opacity: 0.35; pointer-events: none; }

  .groups { display: grid; gap: 8px; }
  .group { display: grid; gap: 8px 28px; padding: 22px 0; border-top: 1px solid var(--line); scroll-margin-top: calc(var(--header-h) + 16px); }
  @media (min-width: 720px) { .group { grid-template-columns: 64px 1fr; } }
  .group-letter { margin: 0; font-size: 1.6rem; color: var(--gold-ink); line-height: 1.2; }
  .names { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px 24px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); }
  .names li { padding: 10px 14px; border-radius: var(--radius-s); background: var(--mist); color: var(--navy-900); font-size: 0.95rem; line-height: 1.4; }
  .names li mark { background: var(--gold-tint); color: inherit; border-radius: 3px; padding: 0 1px; box-shadow: inset 0 -2px 0 var(--gold); }

  .empty { padding: 40px 24px; text-align: center; border: 1px dashed var(--line); border-radius: var(--radius); }
  .empty p { margin: 0.3em 0; }
  .link-btn { border: 0; background: none; padding: 0; font: inherit; color: var(--navy-700); text-decoration: underline; cursor: pointer; }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('#client-search');
  const countEl = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const queryEl = document.querySelector<HTMLElement>('[data-query]');
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-letter-link]')];
  const items = [...document.querySelectorAll<HTMLLIElement>('li[data-name]')];
  const original = new Map(items.map((li) => [li, li.textContent ?? '']));

  const norm = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[^a-z0-9& ]+/g, ' ').replace(/\s+/g, ' ').trim();
  const escapeHtml = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  function highlight(text: string, q: string): string {
    if (!q) return escapeHtml(text);
    const i = text.toLowerCase().indexOf(q);
    if (i < 0) return escapeHtml(text);
    return escapeHtml(text.slice(0, i)) + '<mark>' + escapeHtml(text.slice(i, i + q.length)) + '</mark>' + escapeHtml(text.slice(i + q.length));
  }

  function apply() {
    if (!input) return;
    const raw = input.value.trim();
    const q = norm(raw);
    const lower = raw.toLowerCase();
    let shown = 0;
    for (const li of items) {
      const text = original.get(li) ?? '';
      const match = !q || norm(text).includes(q);
      li.hidden = !match;
      li.innerHTML = match ? highlight(text, lower) : escapeHtml(text);
      if (match) shown++;
    }
    for (const g of groups) {
      const any = g.querySelector('li[data-name]:not([hidden])');
      g.hidden = !any;
      const link = links.find((a) => a.dataset.letterLink === g.dataset.group);
      if (link) {
        if (any) { link.removeAttribute('aria-disabled'); link.removeAttribute('tabindex'); }
        else { link.setAttribute('aria-disabled', 'true'); link.setAttribute('tabindex', '-1'); }
      }
    }
    if (countEl) countEl.textContent = String(shown);
    if (empty) empty.hidden = shown > 0;
    if (queryEl) queryEl.textContent = raw;
  }

  input?.addEventListener('input', apply);
  document.querySelector('[data-clear]')?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    apply();
    input.focus();
  });
</script>
