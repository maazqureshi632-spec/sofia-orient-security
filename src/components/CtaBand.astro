---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props { title?: string; text?: string }
const {
  title = 'Discuss your security requirement',
  text = 'Call or message us on WhatsApp, or send a quote request with the details of your premises.',
} = Astro.props;
---
<section class="cta-band">
  <div class="container cta-inner reveal">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--gold" href={site.phone.href}><Icon name="phone" /> Call {site.phone.display}</a>
      <a class="btn btn--whatsapp" href={site.whatsapp.href} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
      <a class="btn btn--ghost" href="/contact/#quote"><Icon name="doc" /> Request a Quote</a>
    </div>
  </div>
</section>

<style>
  .cta-band { background: var(--navy-900); padding-block: clamp(48px, 7vw, 80px); position: relative; overflow: hidden; }
  .cta-band::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(600px 300px at 90% 0%, rgb(201 162 39 / 0.14), transparent 70%);
  }
  .cta-inner { position: relative; display: grid; gap: 24px; align-items: center; }
  @media (min-width: 960px) { .cta-inner { grid-template-columns: 1fr auto; gap: 48px; } }
  .cta-band h2 { color: var(--white); margin-bottom: 0.4em; }
  .cta-band p { color: rgb(255 255 255 / 0.74); margin: 0; max-width: 56ch; }
</style>
